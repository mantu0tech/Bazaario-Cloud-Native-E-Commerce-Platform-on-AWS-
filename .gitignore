# --- Environment / secrets ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# --- Dependencies ---
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Build output ---
dist/
build/
frontend/dist/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Database (if ever using local SQLite instead of MySQL) ---
backend/data/
*.sqlite
*.db
*.db-shm
*.db-wal

# --- Package manager lockfiles/state (optional - remove these two lines if you want to commit lockfiles) ---
# package-lock.json
# yarn.lock

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor/IDE ---
.vscode/
.idea/
*.swp

# --- Docker ---
docker-compose.override.yml

# --- Coverage / test artifacts ---
coverage/
output.txt
# --- Terraform ---
/terraform/.terraform/
/terraform/.terraform.lock.hcl
/terraform/*.tfstate
/terraform/*.tfstate.*
/terraform/*.tfplan
/terraform/tfplan
/terraform/crash.log
/terraform/*.tfvars
!/terraform/*.tfvars.example
